# Service worker must never be cached, so clients pick up new versions immediately.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# The app shell should always be revalidated so a new build is served right away.
/index.html
  Cache-Control: no-cache

# Hashed build assets are immutable and safe to cache aggressively.
/static/*
  Cache-Control: public, max-age=31536000, immutable
